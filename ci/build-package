#!/usr/bin/env bash
set -euo pipefail

readonly repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly keyring_dir=/tmp/linux-mbp-gnupg

if (( EUID != 0 )); then
    printf 'Error: this script must run as root inside the disposable Arch CI container.\n' >&2
    exit 2
fi

pacman -Syu --noconfirm --needed \
    archlinux-keyring base-devel bc binutils cpio gettext glibc libelf libgcc \
    openssl pahole perl python rust rust-bindgen rust-src tar xxhash xz zlib zstd

repo_uid=$(stat -c %u "${repo_dir}")
repo_gid=$(stat -c %g "${repo_dir}")
if (( repo_uid == 0 )); then
    repo_uid=1000
    repo_gid=1000
    chown -R "${repo_uid}:${repo_gid}" "${repo_dir}"
fi

if getent group "${repo_gid}" >/dev/null; then
    build_group=$(getent group "${repo_gid}" | cut -d: -f1)
else
    build_group=builder
    groupadd --gid "${repo_gid}" "${build_group}"
fi

if getent passwd "${repo_uid}" >/dev/null; then
    build_user=$(getent passwd "${repo_uid}" | cut -d: -f1)
else
    build_user=builder
    useradd --create-home --uid "${repo_uid}" --gid "${build_group}" "${build_user}"
fi
install -d -m 0700 -o "${build_user}" -g "${build_group}" "${keyring_dir}"

printf 'Container CPUs: %s\n' "$(nproc)"
free -h

runuser -u "${build_user}" -- env GNUPGHOME="${keyring_dir}" \
    gpg --batch --no-autostart --quiet --import "${repo_dir}"/keys/pgp/*.asc

runuser -u "${build_user}" -- env \
    GNUPGHOME="${keyring_dir}" \
    MAKEFLAGS="-j$(nproc)" \
    REPO_DIR="${repo_dir}" \
    bash -c 'cd -- "$REPO_DIR"; exec makepkg --cleanbuild --clean --noconfirm'

mapfile -t packages < <(
    runuser -u "${build_user}" -- env REPO_DIR="${repo_dir}" \
        bash -c 'cd -- "$REPO_DIR"; exec makepkg --packagelist'
)

if (( ${#packages[@]} == 0 )); then
    printf 'Error: makepkg did not report an output package.\n' >&2
    exit 1
fi

: > "${repo_dir}/SHA256SUMS"
for package in "${packages[@]}"; do
    if [[ ! -f ${package} ]]; then
        printf 'Error: expected package does not exist: %s\n' "${package}" >&2
        exit 1
    fi
    (
        cd -- "$(dirname -- "${package}")"
        sha256sum -- "$(basename -- "${package}")"
    ) >> "${repo_dir}/SHA256SUMS"
done

printf '\nBuild artifacts:\n'
cat "${repo_dir}/SHA256SUMS"
